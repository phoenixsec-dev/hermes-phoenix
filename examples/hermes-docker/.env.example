# All values here are synthetic examples.
# Host files referenced by *_HOST variables must exist with no group/other
# permission bits (chmod 600) BEFORE docker compose up; :ro mounts do not
# fix insecure host modes.

# Host UID/GID that own ./hermes-home and the identity files below. The
# container's hermes user is remapped to these values, and the plugin
# requires identity files to be owned by the Hermes process user.
HERMES_UID=10000
HERMES_GID=10000

# Bearer variant.
PHOENIX_TOKEN_FILE_HOST=./secrets-example/hermes-main.token

# Both variants.
PHOENIX_SEAL_KEY_HOST=./secrets-example/hermes-main.seal.key
PHOENIX_CA_CERT_HOST=./phoenix-data/ca.crt

# mTLS variant only.
PHOENIX_CLIENT_CERT_HOST=./secrets-example/hermes-main.client.crt
PHOENIX_CLIENT_KEY_HOST=./secrets-example/hermes-main.client.key
